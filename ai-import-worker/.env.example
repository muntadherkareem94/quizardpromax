SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENAI_API_KEY=your-openai-api-key
OPENAI_EXTRACTION_MODEL=gpt-6.1-sol
OPENAI_VERIFICATION_MODEL=gpt-6-astra
OPENAI_SERVICE_TIER=flex
PAGES_PER_BATCH=3
POLL_SECONDS=60
AUTO_PUBLISH=false
MAX_PAGES_PER_JOB=10
RUN_ONCE=true
TEXT_FIRST_ENABLED=true

# FREE ROUTER: new uploads are free_only; paid OpenAI route is off.
ALLOW_PAID_OPENAI=false
FREE_API_REAL_BOOKS_APPROVED=false
FREE_PROVIDER_ORDER=gemini,groq,mistral,openrouter,cloudflare
# To activate a provider: add its secret API key, verify the model's FREE tier
# and permitted commercial/data-sharing usage, then set FREE_CONFIRMED=true
# and a conservative daily request cap BELOW the account's actual quota.
# GEMINI_API_KEY=(secret Railway variable)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FREE_CONFIRMED=false
GEMINI_DAILY_REQUEST_CAP=0
# GROQ_API_KEY=(secret Railway variable)
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FREE_CONFIRMED=false
GROQ_DAILY_REQUEST_CAP=0
# MISTRAL_API_KEY=(secret Railway variable)
MISTRAL_MODEL=mistral-small-latest
MISTRAL_FREE_CONFIRMED=false
MISTRAL_DAILY_REQUEST_CAP=0
# OPENROUTER_API_KEY=(secret Railway variable)
# Must be the EXACT available free model ID ending :free, not a paid model.
OPENROUTER_MODEL=
OPENROUTER_FREE_CONFIRMED=false
OPENROUTER_DAILY_REQUEST_CAP=0
# CLOUDFLARE_API_TOKEN=(secret Railway variable)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_FREE_CONFIRMED=false
CLOUDFLARE_DAILY_REQUEST_CAP=0

# Deterministic, zero-API extraction for unambiguous text-based MCQ chapters.
# If a chapter fails structural checks, use the existing free-AI fallback.
LOCAL_FIRST_ENABLED=true
